"""@it ;
    :belongsToGroup :19E3BE3B2D4B4DEA8186EA4B6C71C720 ;
    :conjunctIdentifier "03.38_v1, 83, 05" .

:2D4955E207F361EAF87C60FFD7C5B6AD a :InspectionPoint ;
