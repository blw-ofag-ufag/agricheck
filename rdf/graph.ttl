"""@it ;
    :belongsToGroup :57A74BCEC2501D05E0532D0E870A0EAF ;
    :conjunctIdentifier "07.07_2021, 01" .

:57A74BCEC2521D05E0532D0E870A0EAF a :InspectionPoint ;
    rdfs:label "Anforderungen bezüglich Erosionsschutz eingehalten"@de,
        "Respecter les exigences en matière de protection contre l'érosion"@fr,
        "Esigenze relative alla protezione contro l'erosione  adempiute"@it ;
