:F52C4C2692A98A2AC69DDBFC142C9CB0 a :InspectionPoint ;
    rdfs:label "Handel auf Anbaubetrieben mit zusätzlicher Kontrolle nach Massstäben von Verarbeitung und Handel"@de ;
