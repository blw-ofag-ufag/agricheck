"""@it ;
    :belongsToGroup :57A74BCEBE9C1D05E0532D0E870A0EAF ;
    :conjunctIdentifier "14.03_2024, 09" .

:57A74BCEBEA61D05E0532D0E870A0EAF a :InspectionPoint ;
