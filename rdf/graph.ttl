La superficie di uscita totale e quella non coperta devono avere le misure minime prescritte per le singole categorie di animali.
"""@it ;
    :belongsToGroup :2DA6A473354A4A3189D0A9458A31EAE8 ;
    :conjunctIdentifier "12.20_2025, A5, 01" .

:72B8BDC711044E47B3522775630E4BF9 a :InspectionPoint ;
    rdfs:label "Futterbilanz vorhanden und vollständig"@de,
        "Bilan fourrager disponible et complet"@fr,
        "Bilancio foraggero disponibile e completo"@it ;
    schema:identifier "01" ;
