:DC1A04A682A34336B63AD7B0DE957FC0 a :InspectionPoint ;
    rdfs:label "Alle Tiere haben dauernd Zugang zu eingestreutem Bereich und erhöhtem Bereich"@de,
        "Les animaux ont en continu accès à une aire couverte de litière et à une aire surélevée"@fr,
        "Tutti gli animali hanno in permanenza accesso  a un'area ricoperta da lettiera e a un'area sopraelevata"@it ;
    schema:identifier "02" ;
    schema:name "Alle Tiere haben dauernd Zugang zu eingestreutem Bereich und erhöhtem Bereich"@de,
        "Les animaux ont en continu accès à une aire couverte de litière et à une aire surélevée"@fr,
        "Tutti gli animali hanno in permanenza accesso  a un'area ricoperta da lettiera e a un'area sopraelevata"@it ;
