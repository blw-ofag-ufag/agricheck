    schema:name "Weiden: alle morastigen Stellen ausgezäunt"@de,
        "Pâturages: tous les endroits bourbeux sont clôturés"@fr,
        "Pascoli: recinzione di tutti i punti fangosi"@it ;
    rdfs:comment """
Ausnahmen: Suhlen für Yaks und Wasserbüffel
"""@de,
