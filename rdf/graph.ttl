"""@it ;
    :belongsToGroup :57A74BCEB4CF1D05E0532D0E870A0EAF ;
    :conjunctIdentifier "01.52_v2, A, PRZ-A 04" .

:57A74BCEB4D61D05E0532D0E870A0EAF a :InspectionPoint ;
    rdfs:label "Trennung unverträglicher Tiere"@de,
