"""@it ;
    :belongsToGroup :5C3AC98795E64F3086833F677ED09F6C ;
    :conjunctIdentifier "03.38_v1, 82, 09" .

:94B55EB71D539164DFB0F75FE3A233B6 a :InspectionPoint ;
    rdfs:label "Krankheitsvorsorge entspricht den Richtlinien"@de ;
    schema:identifier "30.10.06.02" ;
    schema:name "Krankheitsvorsorge entspricht den Richtlinien"@de ;
