"""@it ;
    :belongsToGroup :9F7F05C71FD54CE7A375D3F1B5DB4526 ;
    :conjunctIdentifier "03.30_v1, 02, 13" .

:62A774A8B42F458A92B9EE1C5C8AB29F a :InspectionPoint ;
    rdfs:label "Massnahmen gegen Pflanzenkrankheiten und Pflanzen, die nachteilige Auswirkungen auf die Gesundheit haben"@de,
        "Mesures contre les maladies végétales et les plantes ayant des conséquences négatives sur la santé"@fr,
        "Misure contro le malattie delle piante e le piante con effetti negativi sulla salute"@it ;
    schema:identifier "1.04" ;
    schema:name "Massnahmen gegen Pflanzenkrankheiten und Pflanzen, die nachteilige Auswirkungen auf die Gesundheit haben"@de,
