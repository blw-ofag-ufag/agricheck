:57A74BCEB5351D05E0532D0E870A0EAF a :InspectionPoint ;
    rdfs:label "Bewirtschaftung mit starken Konsequenzen"@de,
        "Conditions d'exploitation avec fort impact"@fr,
        "Gestione con forti conseguenze"@it ;
    schema:description """
Düngung nur mit Bewilligung
Keine PSM (Ausnahmen beim Herbizideinsatz gemäss Weisungen zur DZV)..
"""@de,
