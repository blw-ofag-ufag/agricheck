"""@it ;
    :belongsToGroup :03CBA0CCC0334AA497E94B0613BC4976 ;
    :conjunctIdentifier "08.40_2023, 01" .

:FA4B11F48874A483A608611C2A688B98 a :InspectionPoint ;
    rdfs:label "Anforderungen an Stallmasse/ AKB/ Weide/ Sitzstangen eingehalten, max. Besatzdichte eingehalten"@de ;
    schema:description "Anforderungen an Stallmasse/ AKB/ Weide/ Sitzstangen und Podeste eingehalten, max. Besatzdichte eingehalten"@de ;
