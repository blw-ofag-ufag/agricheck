- gli equidi hanno la possibilità di dissetarsi diverse volte al giorno.
"""@it ;
    :belongsToGroup :8D789BAF0E604F06BD7EAFBCE30BC1CF ;
    :conjunctIdentifier "03.31_v1, 11, 09" .

:21B67D99EBED5239DFB4E53DD9955256 a :InspectionPoint ;
    rdfs:label "Offene Wasserfläche"@de ;
    schema:identifier "30.09.05.03" ;
