:509210DF8B1C417FA601BCAA5293813A a :InspectionPoint ;
    rdfs:label "Auslauf-Dokumentation entspricht den Anforderungen"@de,
        "La documentation sur les sorties correspond aux exigences"@fr,
        "Conformità della documentazione sulle uscite"@it ;
    schema:description """
Zugang zum AKB nach spätestens 3 Tagen eingetragen.
Begründung bei allen Einschränkungen des Zugang der Tiere zum AKB dokumentiert
"""@de,
        """
Accès à l'ACE inscrit au plus tard 3 jours après
Les raisons des restrictions de l'accès à l'ACE sont documentées
"""@fr,
        """
Accesso all'ACE annotato al più tardi entro tre giorni
Il motivo di tutte le limitazioni dell'accesso degli animali all'ACE è documentato
"""@it ;
    schema:identifier "10" ;
    schema:name "Auslauf-Dokumentation entspricht den Anforderungen"@de,
        "La documentation sur les sorties correspond aux exigences"@fr,
        "Conformità della documentazione sulle uscite"@it ;
    rdfs:comment """
Zugang zum AKB nach spätestens 3 Tagen eingetragen.
Begründung bei allen Einschränkungen des Zugang der Tiere zum AKB dokumentiert
"""@de,
        """
Accès à l'ACE inscrit au plus tard 3 jours après
Les raisons des restrictions de l'accès à l'ACE sont documentées
"""@fr,
        """
Accesso all'ACE annotato al più tardi entro tre giorni
Il motivo di tutte le limitazioni dell'accesso degli animali all'ACE è documentato
"""@it ;
    :belongsToGroup :57A74BCEBF261D05E0532D0E870A0EAF ;
