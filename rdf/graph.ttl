    :conjunctIdentifier "02.2_83_v2, 01" .

:57A74BCEB1991D05E0532D0E870A0EAF a :InspectionPoint ;
    rdfs:label "Wiesenstreifen entlang Wegen und Strassen"@de,
        "Bande herbeuse le long des chemins et des routes"@fr,
        "Bordi inerbiti lungo sentieri e strade"@it ;
    schema:description """
Wiesenstreifen von mindestens 0.5 m entlang Wegen und Strassen (gemessen ab Kofferung)
"""@de,
        """
Bande herbeuse d'au moins 0,5 m le long des chemins et des routes (mesurée à partir du coffre)
"""@fr,
        """
Bordi inerbiti di almeno 0.5 m lungo sentieri e strade (misurati dalla massicciata)
"""@it ;
    schema:identifier "01" ;
    schema:name "Wiesenstreifen entlang Wegen und Strassen"@de,
        "Bande herbeuse le long des chemins et des routes"@fr,
        "Bordi inerbiti lungo sentieri e strade"@it ;
    rdfs:comment """
Wiesenstreifen von mindestens 0.5 m entlang Wegen und Strassen (gemessen ab Kofferung)
"""@de,
