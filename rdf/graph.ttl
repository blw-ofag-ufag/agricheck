    :belongsToGroup :57A74BCEC1931D05E0532D0E870A0EAF ;
    :conjunctIdentifier "12.01_2023, A7, 01" .

:57A74BCEC1951D05E0532D0E870A0EAF a :InspectionPoint ;
    rdfs:label "Mind. 15 Lux natürliches Tageslicht im Stall"@de,
        "Lumière du jour, naturelle, d'une intensité d'au moins 15 lux"@fr,
        "Intensità della luce diurna naturale nella stalla min. 15 lux"@it ;
    schema:description """
Alle Ställe, in denen sich die Tiere überwiegend aufhalten, verfügen über Tageslicht von mindestens 15 Lux Stärke (Kunstlicht zur Beurteilung ausschalten!). In Ruhe- und Rückugsbereichen ist eine geringere Beleuchtung zulässig.
"""@de,
        """
