    :belongsToGroup :96539BFA13BC4B2DA07CDB4319099C26 ;
    :conjunctIdentifier "03.32_v1, 24, 11" .

:D1955D83C522464B8F51DE02F32EEECD a :InspectionPoint ;
    rdfs:label "Korrekter Einsatz von Pflanzenschutzmitteln (Getreide, Mais, Kartoffeln, Rüben)"@de,
        "Utilisation correcte des produits phytosanitaires (céréales, maïs, pommes de terre, betteraves)"@fr,
        "Corretto impiego di prodotti fitosanitari (cereali, mais, patate, barbabietole)"@it ;
    schema:description """
Nur zugelassene PSM eingesetzt (gemäss PSM-Verzeichnis des BLV);
keine Winterbehandlung (15. Nov - 15. Feb);
Schadschwelle erhoben und eingetragen;
Einsatz von Herbiziden und Insektiziden gemäss ÖLN-Anforderungen (u.a. Sonderbewilligungen vorhanden).
"""@de,
        """
Seuls des PPh autorisés sont utilisés (selon l'index PPh de l'OSAV);
pas de traitement durant la saison d'hiver (15 nov. au 15 févr.);
seuil de tolérance établi et enregistré;
utilisation d'herbicides et d'insecticides selon les exigences PER (entre autre, autorisation spéciale disponible).
"""@fr,
        """
Impiego esclusivo di PF autorizzati (secondo l'elenco PF dell'USAV);
nessun trattamento invernale (15 nov. - 15. feb.);
soglia critica rilevata e registrata;
impiego di erbicidi e insetticidi secondo gli oneri della PER (autorizzazinoi speciali presenti, tra l'altro).
"""@it ;
    schema:identifier "02" ;
    schema:name "Korrekter Einsatz von Pflanzenschutzmitteln (Getreide, Mais, Kartoffeln, Rüben)"@de,
        "Utilisation correcte des produits phytosanitaires (céréales, maïs, pommes de terre, betteraves)"@fr,
        "Corretto impiego di prodotti fitosanitari (cereali, mais, patate, barbabietole)"@it ;
