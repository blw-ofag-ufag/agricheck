"""@it ;
    :belongsToGroup :AC65422D5D9143E3B974E4782451FE70 ;
    :conjunctIdentifier "16.05_2023, 03" .

:C6A5145F2E4E639DB7074E7C919B0ED2 a :InspectionPoint ;
    rdfs:label "Einheimische Art, Regenbogenforelle oder Ausnahmebewilligung der MKA vorhanden"@de ;
    schema:identifier "30.22.33" ;
