:57A74BCEC7411D05E0532D0E870A0EAF a :InspectionPoint ;
    rdfs:label "Einzeltreibgänge für Rinder"@de,
        "Couloirs d'acheminement individuels pour les bovins "@fr,
        "Corsie individuali per bovini"@it ;
    schema:description """
Anforderungen
‒ Einzeltreibgänge für Rinder sind mit einem Aufsprungschutz versehen;
‒ Für Rinder gilt eine lichte Höhe von 20 cm über dem Widerrist.
"""@de,
        """
Exigences
‒ Les couloirs d'acheminement individuels pour les bovins sont aménagés de manière à empêcher les animaux de grimper les uns sur les autres.
‒ Pour les bovins, l'espace libre en hauteur doit être de 20 cm au moins au-dessus du garrot.
"""@fr,
        """
Anforderungen
‒ Einzeltreibgänge für Rinder sind mit einem Aufsprungschutz versehen;
‒ Für Rinder gilt eine lichte Höhe von 20 cm über dem Widerrist.
"""@it ;
    schema:identifier "INF-C 03" ;
    schema:name "Einzeltreibgänge für Rinder"@de,
        "Couloirs d'acheminement individuels pour les bovins "@fr,
