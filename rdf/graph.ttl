"""@it ;
    :belongsToGroup :EA4B708C21EA4827A80F66E257051D8C ;
    :conjunctIdentifier "03.36_v1, 63, 09" .

:1E33C3F2FDB04167AC1FA1F05F371D1F a :InspectionPoint ;
    rdfs:label "Belegung der Stallungen"@de,
