:57A74BCEB6751D05E0532D0E870A0EAF a :InspectionPoint ;
    rdfs:label "Haltungseinheit: Einrichtungen"@de,
        "Unité d'élevage: installations"@fr,
        "Unità di detenzione: installazioni"@it ;
    schema:description """
Haltungseinheit: Einrichtungen (Strukturierung, Rückzugsmöglichkeit, Boden, Verletzungsgefahr)
"""@de,
