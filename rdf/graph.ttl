"""@it ;
    :belongsToGroup :8B6B03FB82FC4F82A6F39003F7852003 ;
    :conjunctIdentifier "12.20_2025, A4, 06" .

:32F3412105A2497D88887DE53F0DC043 a :InspectionPoint ;
