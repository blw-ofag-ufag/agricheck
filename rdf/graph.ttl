"""@it ;
    :belongsToGroup :174332770D3A40839814472A1CD74C0D ;
    :conjunctIdentifier "03.36_v1, 62, 11" .

:66CE81E7A8F141958E258839EC66A8DD a :InspectionPoint ;
    rdfs:label "Deklaration der Zahl der gesömmerten Tiere und Tage ist korrekt"@de,
        "La déclaration du nombre d'animaux estivés et du nombre de jours d'estivage est correct"@fr,
        "Dichiarazione corretta del numero di animali estivati e di giorni"@it ;
    schema:description """
Die Zahl der gesömmerten Tiere und Tage ist korrekt, plausibel und nachvollziehbar
"""@de,
        """
Le nombre d'animaux estivés et du nombre de jours d'estivage est correct, compréhensible et plausible
"""@fr,
        """
Numero di animali estivati e di giorni corretto, plausibile e rintracciabile
"""@it ;
    schema:identifier "04" ;
    schema:name "Deklaration der Zahl der gesömmerten Tiere und Tage ist korrekt"@de,
        "La déclaration du nombre d'animaux estivés et du nombre de jours d'estivage est correct"@fr,
        "Dichiarazione corretta del numero di animali estivati e di giorni"@it ;
    rdfs:comment """
Die Zahl der gesömmerten Tiere und Tage ist korrekt, plausibel und nachvollziehbar
"""@de,
