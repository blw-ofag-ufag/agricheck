:C8984ECD055F33DEDE7BBD53E713750C a :InspectionPoint ;
    rdfs:label "Einstreu hat Bio-Qualität"@de ;
    schema:description "Die Einstreu landwirtschaftlichen Ursprungs hat Bio-Qualität"@de ;
    schema:identifier "30.08.04" ;
    schema:name "Einstreu hat Bio-Qualität"@de ;
    rdfs:comment "Die Einstreu landwirtschaftlichen Ursprungs hat Bio-Qualität"@de ;
