:57A74BCEC6FF1D05E0532D0E870A0EAF a :InspectionPoint ;
    rdfs:label "Min 10 Bäume in min. 20 Aren"@de,
        "Au min 10 arbres sur au min. 20 ares"@fr,
        "Min. 10 alberi in min. 20 are"@it ;
    schema:description """
Die Mindestfläche des Obstgartens muss 20 Aren betragen und dieser muss mindestens 10 Hochstamm-Feldobstbäume enthalten.
"""@de,
