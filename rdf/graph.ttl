:57A74BCEB9181D05E0532D0E870A0EAF a :InspectionPoint ;
    rdfs:label "Lärmpegel <85 dB"@de,
        "Niveau sonore < 85 dB"@fr,
        "Livello sonoro < 85 dB"@it ;
    schema:description """
Anforderungen:
- Maximal 85 dB im Warte- und Zutriebsbereich bei laufendem Betrieb;
- Einzelne Lärmspitzen sind erlaubt.
"""@de,
        """
Exigences
- Au maximum 85 dB dans les aires d'attente et les zones d'acheminement lorsque l'installation est en fonction ;
- Des pics sonores sporadiques sont admis.
"""@fr,
        """
Anforderungen:
- Maximal 85 dB im Warte- und Zutriebsbereich bei laufendem Betrieb;
- Einzelne Lärmspitzen sind erlaubt.
"""@it ;
