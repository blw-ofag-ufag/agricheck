"""@it ;
    :belongsToGroup :57A74BCEC5661D05E0532D0E870A0EAF ;
    :conjunctIdentifier "07.03_2025, 01" .

:57A74BCEC5691D05E0532D0E870A0EAF a :InspectionPoint ;
    rdfs:label "Vorschriftsgemässe Bewirtschaftung von Objekten in Inventaren nationaler Bedeutung, inklusive der dazugehörigen Pufferzonen, bei vorliegendem rechtskräftigen Entscheid"@de,
        "Exploitation conforme aux prescriptions des objets inscrits dans les inventaires d'importance nationale, y compris les zones tampon, lorsqu'il existe une décision exécutoire"@fr,
        "Gestione conforme alle prescrizioni di oggetti in inventari d'importanza nazionale, inclusa quella delle rispettive zone tampone, con decisione cresciuta in giudicato"@it ;
