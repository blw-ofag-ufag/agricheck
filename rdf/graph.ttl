"""@it ;
    :belongsToGroup :64BB08567F23412CA7F4FD2A2B83BFDE ;
    :conjunctIdentifier "03.36_v1, 61, 07" .

:3F3C5A0FB7E6D8BF7D515CC1A8789F2E a :InspectionPoint ;
